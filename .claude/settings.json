{
  "coauthorship": false,
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "lup@inkwell": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "inkwell": {
      "source": {
        "path": "./.claude/plugins",
        "source": "directory"
      }
    }
  },
  "fileSuggestion": {
    "command": ".claude/plugins/lup/scripts/file_suggest.sh",
    "type": "command"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Skill(lup:hooks)",
      "EnterWorktree",
      "ExitWorktree",
      "Read(./.claude/settings.json.local*)",
      "Read(./sync.json.local)",
      "mcp__plugin_lup_source",
      "mcp__plugin_lup_research",
      "mcp__plugin_lup_docs"
    ],
    "deny": [
      "Read(./**/.env*.local)",
      "Read(./**/.env.local)",
      "Read(./**/secrets*.local)",
      "Read(./**/*.secret.local)",
      "Read(~/.ssh)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/credentials/**)"
    ]
  },
  "sandbox": {
    "credentials": {
      "files": [
        {
          "mode": "deny",
          "path": "~/.ssh"
        },
        {
          "mode": "deny",
          "path": "~/.aws/credentials"
        }
      ]
    },
    "enabled": true,
    "excludedCommands": [],
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv"
      ],
      "denyWrite": []
    },
    "network": {
      "allowedDomains": [
        "docs.claude.com",
        "code.claude.com",
        "platform.claude.com",
        "claude.ai",
        "developers.openai.com",
        "learn.chatgpt.com",
        "github.com",
        "api.github.com",
        "githubusercontent.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "arxiv.org",
        "en.wikipedia.org",
        "googleapis.com",
        "*.googleapis.com",
        "docs.google.com",
        "127.0.0.1",
        "localhost",
        "api.anthropic.com"
      ]
    }
  }
}
