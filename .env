# Inkwell — template defaults (override in .env.local)

# Model settings
# AGENT_MODEL=claude-opus-5
# AGENT_MAX_THINKING_TOKENS=127999
# AGENT_MAX_BUDGET_USD=10.00
# AGENT_MAX_TURNS=100

# Paths
# AGENT_NOTES_PATH=./notes
# AGENT_LOGS_PATH=./logs
# INKWELL_STYLE_CORPUS_PATH=./config/style

# Google Docs (configured via `inkwell setup`)
# GOOGLE_CREDENTIALS_PATH=./config/google_credentials.json
# GOOGLE_TOKEN_PATH=./config/google_token.json

# Research corpus
# On rather than commented out, so it is the repo's default and not an example.
# The semantic layer is what answers a question sharing no vocabulary with the
# corpus, which is most of what the plan stage asks it — the briefing every run
# is handed before it writes a research question is a nearest-neighbour query.
# It embeds with a local model, so this costs no key and no per-query network
# call; the price is disk and one pass of `corpus embed` after a sweep.
INKWELL_CORPUS_EMBEDDINGS=true

# Research API keys
# EXA_API_KEY=your-exa-key
# FRED_API_KEY=your-fred-key

# Claude conversation extraction
# CLAUDE_COOKIE=your-session-cookie
# CLAUDE_ORG_UUID=your-org-uuid
