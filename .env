# Inkwell — template defaults (override in .env.local)

# Model settings
# AGENT_MODEL=claude-opus-4-6
# AGENT_MAX_THINKING_TOKENS=127999
# AGENT_MAX_BUDGET_USD=10.00
# AGENT_MAX_TURNS=100

# Paths
# AGENT_NOTES_PATH=./notes
# AGENT_LOGS_PATH=./logs
# INKWELL_STYLE_CORPUS_PATH=./config/style

# Google Docs (configured via `inkwell setup`)
# GOOGLE_CREDENTIALS_PATH=./config/google_credentials.json
# GOOGLE_TOKEN_PATH=./config/google_token.json

# Research API keys
# EXA_API_KEY=your-exa-key
# FRED_API_KEY=your-fred-key

# Claude conversation extraction
# CLAUDE_COOKIE=your-session-cookie
# CLAUDE_ORG_UUID=your-org-uuid
